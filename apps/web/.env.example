# Server-side base URL for the products microservice (used during SSR / build)
PRODUCTS_API_URL=http://localhost:4001

# Public base URLs the browser will call directly
NEXT_PUBLIC_PRODUCTS_API_URL=http://localhost:4001
NEXT_PUBLIC_UPLOAD_API_URL=http://localhost:4002

# Server-only Gemini credentials for the catalogue-grounded store assistant.
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.8-flash.
GEMINI_CHAT_MODEL=gemini-3.8-flash
