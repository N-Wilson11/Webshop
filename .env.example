# Shared admin token for the CMS (products + upload services)
ADMIN_TOKEN=

# Public URLs the browser uses to reach the microservices directly.
# When running via docker-compose, these stay as localhost because ports are published to the host.
NEXT_PUBLIC_PRODUCTS_API_URL=
NEXT_PUBLIC_UPLOAD_API_URL=
UPLOAD_PUBLIC_URL=

# SMTP connection URL (URL-encode reserved characters in the username/password).
# Example: smtp://username%40example.com:password@smtp.example.com:587
BREVO_API_KEY=

# SMTP is used only when BREVO_API_KEY is not configured.
SMTP_URL=
# Alternatively, configure SMTP with separate values (recommended for Brevo).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Sender displayed on order confirmations (for example: Cookie Corner <orders@example.com>)
MAIL_FROM=

# Public base URL of the storefront, used to resolve relative product image URLs in emails.
# Only used when running mail-service directly on the host (e.g. `npm run dev`).
# When running via docker-compose, mail-service always uses http://web:3000 internally instead.
PUBLIC_WEB_URL=